--- /dev/null
+++ b/modelexpress/engines/sglang/checkpoint_cache.py
@@ -0,0 +1,34 @@
+# SPDX-FileCopyrightText: Copyright (c) 2026 Phala Network
+# SPDX-License-Identifier: Apache-2.0
+"""Coordinate native-loader cache release across mixed RDMA/native ranks."""
+
+import torch
+
+
+def release_native_checkpoint_cache(adapter, load_config):
+    extra = getattr(load_config, "model_loader_extra_config", None) or {}
+    if not extra.get("drop_checkpoint_cache_after_model_load", False):
+        return
+
+    files = sorted(set(getattr(adapter, "native_checkpoint_files", ())))
+    nnodes = 1
+    if torch.distributed.is_initialized():
+        from sglang.srt.runtime_context import get_parallel
+
+        parallel = get_parallel()
+        group = parallel.world_group
+        nnodes = parallel.nnodes
+        per_rank = [None] * group.world_size
+        torch.distributed.all_gather_object(per_rank, files, group=group.cpu_group)
+        files = sorted({path for rank_files in per_rank for path in rank_files})
+
+    if files:
+        # Reuse the engine's CUDA/TP synchronization and per-node distribution.
+        # All ranks see the same union, including ranks that loaded via RDMA.
+        from sglang.srt.model_loader.weight_utils import (
+            drop_checkpoint_cache_after_model_load,
+        )
+
+        drop_checkpoint_cache_after_model_load(files, nnodes)
+    if hasattr(adapter, "native_checkpoint_files"):
+        adapter.native_checkpoint_files.clear()
