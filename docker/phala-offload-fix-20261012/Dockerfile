from pathlib import Path
import hashlib
import json
import py_compile
import shutil

entries = json.loads('[{"after_sha256": "1cd9ea1517019337857b5e4b8cbe878d67634bb83122ed0a169cecdacb54782d", "before_sha256": "439819917ec76e3088b309170cf90ada4b57717524b9ddc52824fb0e4b23b0ef", "installed_sha256": "1cd9ea1517019337857b5e4b8cbe878d67634bb83122ed0a169cecdacb54782d", "runtime_path": "python/sglang/srt/managers/cache_controller.py", "staged_name": "cache_controller.py"}, {"after_sha256": "833cda7d522069f5f6b839283cdd04df9342eac18f2341240132b1a6a2fc8402", "before_sha256": "c9c3be8ce5fd22cca7ee1ad4325fb92f8ce071c6e02206201ab3fac1d0a772e3", "installed_sha256": "833cda7d522069f5f6b839283cdd04df9342eac18f2341240132b1a6a2fc8402", "runtime_path": "python/sglang/srt/mem_cache/hybrid_cache/hybrid_cache_controller.py", "staged_name": "hybrid_cache_controller.py"}, {"after_sha256": "ab8b179542d7a8250c2adffec2104d1e995799c6be53f71151589a114c41399e", "before_sha256": "c6f1764166c371cf050f05c966daed8ded366365163a69f066569cc74e2575c3", "installed_sha256": "ab8b179542d7a8250c2adffec2104d1e995799c6be53f71151589a114c41399e", "runtime_path": "python/sglang/srt/mem_cache/unified_radix_cache.py", "staged_name": "unified_radix_cache.py"}]')
root = Path('/sgl-workspace/sglang')
staging = Path('/tmp/phala-offload-repair-overlay')
for entry in entries:
    source = staging / entry['staged_name']
    target = root / entry['runtime_path']
    before = hashlib.sha256(target.read_bytes().replace(b'\r\n', b'\n')).hexdigest()
    assert before == entry['before_sha256'], entry['runtime_path']
    after = hashlib.sha256(source.read_bytes().replace(b'\r\n', b'\n')).hexdigest()
    assert after == entry['after_sha256'], entry['runtime_path']
    target.write_bytes(source.read_bytes().replace(b'\r\n', b'\n'))
    py_compile.compile(str(target), doraise=True)
    assert hashlib.sha256(target.read_bytes()).hexdigest() == entry['installed_sha256']
shutil.rmtree(staging)
print('PASS_OFFLOAD_REPAIR_OVERLAY', len(entries))
PY
