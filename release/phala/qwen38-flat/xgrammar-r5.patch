@@ -757,6 +757,41 @@ Result<ObjectSpec, SchemaError> SchemaParser::ParseObject(const picojson::object
     spec.allow_unevaluated_properties = false;
   }
 
+  // "required" is independent of "properties" in JSON Schema. Materialize
+  // undeclared required names before generation: the properties-only emitter
+  // would otherwise ignore them (or compile a required object as empty).
+  // Iterate the input array, not the unordered set, for deterministic output.
+  if (schema.count("required")) {
+    std::unordered_set<std::string> declared;
+    for (const auto& property : spec.properties) declared.insert(property.name);
+    for (const auto& req : schema.at("required").get<picojson::array>()) {
+      const auto& name = req.get<std::string>();
+      if (!declared.insert(name).second) continue;
+      if (!spec.pattern_properties.empty() || spec.property_names) {
+        return ResultErr<SchemaError>(
+            SchemaErrorType::kInvalidSchema,
+            "Undeclared required names with patternProperties/propertyNames are unsupported; "
+            "declare the required property explicitly: " + name
+        );
+      }
+      const bool has_additional = schema.count("additionalProperties");
+      const bool has_unevaluated = schema.count("unevaluatedProperties");
+      if ((has_additional && !spec.allow_additional_properties) ||
+          (!has_additional && has_unevaluated && !spec.allow_unevaluated_properties)) {
+        return ResultErr<SchemaError>(
+            SchemaErrorType::kUnsatisfiableSchema,
+            "Required property is forbidden by the object schema: " + name
+        );
+      }
+      // The strict-mode default may close *optional* additional fields, but
+      // cannot erase an explicitly required name permitted by the input schema.
+      SchemaSpecPtr value = has_additional ? spec.additional_properties_schema
+                                          : spec.unevaluated_properties_schema;
+      if (!value) value = SchemaSpec::Make(AnySpec{}, "", name);
+      spec.properties.push_back({name, value});
+    }
+  }
+
